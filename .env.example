# ============================================
# SYSTEM LLM BACKEND — ENV TEMPLATE
# Copy ke `.env` dan isi nilainya. `.env` di-gitignore.
# Stack: Supabase (DB + Storage) + Fly.io (backend)
# ============================================

# --- Database (Supabase) ---
# Pakai Session Pooler (Connect > Session pooler). Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Storage (Supabase Storage) ---
STORAGE_TYPE=supabase
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=        # Project Settings > API Keys > service_role (sb_secret_...)
SUPABASE_STORAGE_BUCKET=documents

# --- LLM API Keys ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- JWT Security ---
SECRET_KEY=        # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://<your-app>.vercel.app"]

# --- App ---
DEBUG=false

# --- Sentry error monitoring (leave SENTRY_DSN blank to disable, e.g. local dev) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
